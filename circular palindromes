import java.io.*;

public class Solution {
    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine());
        String s = br.readLine();
        String t = s + s;
        int m = 2 * n;

        int[] odd = new int[m];
        int[] even = new int[m];

        // Odd palindromes
        for (int i = 0, l = 0, r = -1; i < m; i++) {
            int k = i > r ? 1 : Math.min(odd[l + r - i], r - i + 1);
            while (i-k >= 0 && i+k < m &&
                   t.charAt(i-k) == t.charAt(i+k)) k++;
            odd[i] = k--;
            if (i+k > r) {
                l = i-k;
                r = i+k;
            }
        }

        // Even palindromes
        for (int i = 0, l = 0, r = -1; i < m; i++) {
            int k = i > r ? 0 : Math.min(even[l+r-i+1], r-i+1);
            while (i-k-1 >= 0 && i+k < m &&
                   t.charAt(i-k-1) == t.charAt(i+k)) k++;
            even[i] = k--;
            if (i+k > r) {
                l = i-k-1;
                r = i+k;
            }
        }

        StringBuilder out = new StringBuilder();

        for (int st = 0; st < n; st++) {
            int end = st + n - 1;
            int best = 1;

            for (int c = st; c <= end; c++) {

                // Odd palindrome centered at c
                int r = Math.min(odd[c],
                        Math.min(c - st + 1, end - c + 1));
                best = Math.max(best, 2 * r - 1);

                // Even palindrome centered between c and c+1
                if (c + 1 <= end) {
                    r = Math.min(even[c + 1],
                            Math.min(c + 1 - st, end - c));
                    best = Math.max(best, 2 * r);
                }
            }

            out.append(best).append('\n');
        }

        System.out.print(out);
    }
}
