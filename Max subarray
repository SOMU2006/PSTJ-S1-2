import java.io.*;
import java.util.*;

class Result {

    public static long maximumSum(List<Long> a, long m) {
        TreeSet<Long> set = new TreeSet<>();

        long prefix = 0;
        long max = 0;

        set.add(0L);

        for (long value : a) {
            prefix = (prefix + value % m) % m;

            // Find the smallest previous prefix > current prefix
            Long next = set.higher(prefix);

            if (next != null) {
                max = Math.max(max, (prefix - next + m) % m);
            }

            // Also consider prefix itself
            max = Math.max(max, prefix);

            set.add(prefix);
        }

        return max;
    }
}

public class Solution {

    public static void main(String[] args) throws IOException {

        BufferedReader br = new BufferedReader(
            new InputStreamReader(System.in)
        );

        int q = Integer.parseInt(br.readLine().trim());

        while (q-- > 0) {

            String[] first = br.readLine().trim().split(" ");

            int n = Integer.parseInt(first[0]);
            long m = Long.parseLong(first[1]);

            String[] values = br.readLine().trim().split(" ");

            List<Long> a = new ArrayList<>();

            for (int i = 0; i < n; i++) {
                a.add(Long.parseLong(values[i]));
            }

            System.out.println(Result.maximumSum(a, m));
        }

        br.close();
    }
}
